# Supabase (kunci anon saja; jangan pernah memasukkan service_role)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sumber data: "mock" (data contoh, default) atau "api" (API BPS Konawe lewat proxy)
EXPO_PUBLIC_DATA_SOURCE=mock
# URL proxy/backend yang meneruskan ke WebAPI BPS. JANGAN taruh API key BPS di sini (terbaca publik).
EXPO_PUBLIC_API_BASE_URL=
# Kode wilayah BPS Kab. Konawe (verifikasi lewat daftar domain WebAPI BPS)
EXPO_PUBLIC_BPS_DOMAIN_CODE=
